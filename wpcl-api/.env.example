APP_NAME=WPCL-API
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Token wajib yang harus dikirim HP via header 'X-API-Token'
API_TOKEN=change_this_to_long_random_string

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Vercel: pakai Neon PostgreSQL (gratis) atau database external lain
DB_CONNECTION=pgsql
DB_HOST=your-host.neon.tech
DB_PORT=5432
DB_DATABASE=wpcl
DB_USERNAME=wpcl_user
DB_PASSWORD=change_this

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_DRIVER=array

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-app-name.vercel.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
